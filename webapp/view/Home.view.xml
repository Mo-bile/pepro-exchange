<mvc:View controllerName="pepero.exchange.peperoexchange.controller.Home"
    xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m">
    <Page id="page" title="빼빼로 증권거래소" class="sapUiResponsiveContentPadding">
        <customHeader>
            <Bar id="homeHeader">
                <contentMiddle>
                    <Title id="homeBrandTitle" text="빼빼로 증권거래소" level="H2" class="peperoBrandTitle" />
                </contentMiddle>
            </Bar>
        </customHeader>
        <content>
            <VBox id="homeContent" class="marketPixelHero" alignItems="Center" justifyContent="Center">
                <!--로고 -->
                <Image src="/image/pepero_individual_pngs/home.png" width="450px" height="250px"/>
                
                <VBox id="homeIntro" class="sapUiMediumMarginBottom" alignItems="Center">
                    <Title id="homeWelcomeTitle" text="달콤한 빼빼로 랜드에 오신 걸 환영해요!" level="H2" wrapping="true" class="peperoBrandTitle sapUiSmallMarginBottom" />
                    <Text id="homeNotice" text="오르락내리락, 가격 롤러코스터를 즐겨보세요." class="sapUiTinyMarginBottom" />
                    <Text id="homeIntroDescription" text="빼빼로 종목을 사고팔며 나만의 자산을 불려보세요!" />
                </VBox>

                <!-- 첫번째 박스 -->
                <Panel id="homeRulesPanel" class="peperoTimerBox sapUiMediumMarginTop" width="600px" height="400px" >
                    <HBox width="100%" justifyContent="Center">
                    <Image src="/image/pepero_individual_pngs/home1.png" width="250px" height="100px"/>
                    </HBox>
                    <content>
                        <VBox id="homeRulesContent">
                            <VBox id="homeCashRule" class="sapUiSmallMarginBottom">
                                <Label id="homeCashLabel" text="초기 자금 · 11,110 PPR" design="Bold" wrapping="true" class="peperoBrandTitle" />
                                <Text id="homeInitialCash" text="주머니에 쏙! 놀이 자금을 챙기고 출발해요." />
                            </VBox>
                            <VBox id="homeDurationRule" class="sapUiSmallMarginBottom">
                                <Label id="homeDurationLabel" text="게임 시간 · 3분" design="Bold" class="peperoBrandTitle" />
                                <Text id="homeGameDuration" text="신나는 3분 동안 나만의 매매 타이밍을 찾아보세요." />
                            </VBox>
                            <VBox id="homeFeeRule">
                                <Label id="homeFeeLabel" text="매매 수수료 · 없음" design="Bold" class="peperoBrandTitle" />
                                <Text id="homeTradingFee" text="사고팔 때 수수료는 0! 가볍게 거래를 즐겨요." />
                            </VBox>
                        </VBox>
                    </content>
                </Panel>

                <!-- 두번째 박스 -->
                <Panel id="homeChallengePanel" class="peperoTimerBox sapUiMediumMarginTop sapUiSmallMarginBottom" width="600px" height="350px">
                    <content>

                    <HBox width="100%" justifyContent="Center">
                    <Image src="/image/pepero_individual_pngs/home2.png" width="250px" height="100px"/>
                    </HBox>

                        <VBox id="homeChallengeContent">
                            <Text id="homeChallengeNotice" text="랜드 속 작은 놀이터에도 들러볼까요?" class="peperoBrandTitle sapUiSmallMarginBottom" />
                            <Text id="homeChallengeDescription" text="시장에서 원할 때 참여해, 11.11초에 딱 맞춰 멈춰보세요!" class="sapUiSmallMarginBottom" />
                            <Text id="homeChallengeOptional" text="참여는 자유! 빼빼로 매매만 즐겨도 좋아요." />
                        </VBox>
                    </content>
                </Panel>
                <Button id="startButton" text="게임 시작! 빼빼로 랜드로 출발" press=".onStart" type="Emphasized" class="peperoGameButton peperoStart sapUiMediumMarginBottom" />
            </VBox>
        </content>
    </Page>
</mvc:View>
