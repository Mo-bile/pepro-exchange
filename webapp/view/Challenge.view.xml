<mvc:View controllerName="pepero.exchange.peperoexchange.controller.Challenge"
    xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m">
    <!-- D / SDB·JMJ: 화면 이동만 연결한 기본 화면 -->
    <Page id="challengePage" title="11.11초 챌린지">
        <customHeader>
            <Bar id="challengeHeader">
                <contentMiddle>
                    <Title id="challengeBrandTitle" text="11.11초 챌린지" level="H2" class="peperoBrandTitle" />
                </contentMiddle>
            </Bar>
        </customHeader>
        <content>
            <VBox id="challengeContent" class="sapUiResponsiveContentPadding sapUiMediumMarginTop">
                <VBox id="challengeCard" width="100%" class="peperoCard">
                    <Text id="challengeNotice" text="화면 이동 확인용 기본 화면입니다. 게임 기능은 구현 예정입니다." class="sapUiSmallMarginBottom" />
                    <Button id="returnButton" text="시장으로 돌아가기" press=".onMarket" type="Emphasized" class="sapUiSmallMarginBottom" />
                </VBox>
            </VBox>
            <Panel width="80%">
            <VBox width="100%" 
                  alignItems="Center" 
                  class="sapUiSmallMarginBottom"
                  justifyContent="Center">
            <HBox>
                <!--<Image src="/>-->
                <Title text="HAPPY PEPERO DAY" class="sapUiSmallMarginBottom" level="H1"/>
            </HBox>
                <Title text="11.11 CHALLENGE" class="sapUiSmallMarginBottom" level="H3"/>
                <Text text="11.11초 빼빼로를 잡아보세요" class="peperoBrandTitle"/>
            <HBox>
                <!--<Image src=  이미지 링크 넣기 />-->
                <Title text="II.II" class="sapUiSmallMarginBottom" level="H1"/>
                <!--<Image src=  이미지 링크 넣기 />-->
            </HBox>
            
             <Panel width="100%" class="peperoCard">
                <VBox width="100%" 
                  alignItems="Center" 
                  class="sapUiSmallMarginBottom"
                  justifyContent="Center">
                    <Text text="타이머 띄우기" id="text"></Text>
                    <Text text="TARGET 11.11 SEC"></Text>
                </VBox>
                </Panel>
                <HBox>
                    <Button icon="sap-icon://media-play" text="START" press="start()" width="7rem"/>
                    <Button icon="sap-icon://media-pause" text="STOP" press="stop()" width="7rem"/>
                    <Button icon="sap-icon://media-rewind" text="RETRY" press="retry()" width="7rem"/>
                </HBox>
    
            </VBox>
            </Panel>
        </content>
    </Page>
</mvc:View>
