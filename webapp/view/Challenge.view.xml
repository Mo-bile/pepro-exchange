<mvc:View controllerName="pepero.exchange.peperoexchange.controller.Challenge"
    xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m">
    <!-- D / SDB·JMJ: 화면 이동만 연결한 기본 화면 -->
    <Page id="challengePage" title="11.11초 챌린지">
        <customHeader>
            <Bar id="challengeHeader">
                <contentMiddle>
                    <Title id="challengeBrandTitle" text="11.11초 챌린지" level="H2" class="peperoBrandTitle" />
                </contentMiddle>
            </Bar>
        </customHeader>
        <content>
        <!--
            <VBox id="challengeContent" class="sapUiResponsiveContentPadding sapUiMediumMarginTop">
                <VBox id="challengeCard" width="100%" class="peperoCard">
                    <Text id="challengeNotice" text="화면 이동 확인용 기본 화면입니다. 게임 기능은 구현 예정입니다." class="sapUiSmallMarginBottom" />
                    <Button id="returnButton" text="시장으로 돌아가기" press=".onMarket" type="Emphasized" class="sapUiSmallMarginBottom" />
                </VBox>
            </VBox>
        -->
            <VBox width="100%" 
                  alignItems="Center" 
                  class="marketPixelHero"
                  justifyContent="Center">
                
            <HBox>            

            <Panel width="800px" class="peperoCard peperoGameFrame sapUiSmallMarginBottom sapUiMediumMarginEnd">

            <!-- HAPPY PEPERO DAY 타이틀 -->
            <VBox width="100%" alignItems="Center" class="sapUiSmallMarginBottom">

            <HBox  alignItems="Center" justifyContent="Center">
                <Image src="/image/pepero_individual_pngs/decoration_small_hearts.png"
                       width="100px" height="50px"/>
                <Title text="HAPPY PEPERO DAY"
                       class="peperoBrandTitle peperoMainTitle sapUiTinyMarginTop" 
                       level="H1"/>
                <Image src="/image/pepero_individual_pngs/decoration_small_hearts.png"
                       width="100px" height="50px" />
            </HBox>
            </VBox>

              <!-- 11.11 챌린지 이미지 -->
                <VBox width="100%" 
                  alignItems="Center" 
                  justifyContent="Center">

                <HBox justifyContent="Center"
                      class="peperoChallengeTitle">

                <Image src="/image/pepero_individual_pngs/title.png"
                        width="300px" />
                </HBox>
                </VBox>

            <HBox  justifyContent="Center">
                <Image src="/image/pepero_individual_pngs/pepero_01_pink_choco.png"
                       width="40px" height="50px"/>
                <Image src="/image/pepero_individual_pngs/pepero_03_choco_stripes.png"
                       width="40px" height="50px"/>
                 <Image src="/image/pepero_individual_pngs/decoration_heart_pink.png"
                       width="40px" height="30px" class="sapUiTinyMarginTop"/>
                <Image src="/image/pepero_individual_pngs/pepero_04_pink_stripes.png"
                       width="40px" height="50px"/>
                <Image src="/image/pepero_individual_pngs/pepero_06_cookies_cream.png"
                       width="40px" height="50px"/>
          
            </HBox>

            <!-- 타이머 박스 -->

            <VBox width="100%" alignItems="Center">
                <Panel width="600px" class="peperoTimerBox sapUiMediumMarginTop" >

                    <VBox width="100%" alignItems="Center">
                <!-- 타이머 제목 -->
                    <Text text="SWEET STOPWATCH" wrapping="false"
                          class="peperoBrandTitle sapUiSmallMarginBottom"/>
                    <Title id="text"
                           text="{game>/challenge/displayTime}"
                           class="peperoTime peperoTimePlate" 
                           level="H1"/>
                 <!-- 타이머 시간 -->
                    <Text text="TARGET 11.11 SEC" wrapping="false"
                           class="peperoTarget sapUiSmallMarginTop" />
                </VBox>
                </Panel>
             </VBox>

                <HBox alignItems="Center" justifyContent="Center" class="sapUiMediumMarginTop">

                <!-- 왼쪽 도트아트 -->
                    <Image src="/image/pepero_individual_pngs/decoration_small_hearts.png"
                           width="100px" height="50px"
                           class="sapUiSmallMarginEnd" />
        
                 <!-- START 버튼 -->
                    <Button text="START" 
                            icon="sap-icon://media-play"
                            width="11rem"
                            class="peperoGameButton peperoStart"
                            visible="{= ${game>/challenge/status} === 'UNUSED' }" 
                            press=".onStart" />

                 <!-- STOP 버튼 -->
                    <Button text="STOP" 
                            icon="sap-icon://media-pause"
                            width="11rem"
                            class="peperoGameButton peperoStop"
                            visible="{= ${game>/challenge/status} === 'ACTIVE' }" 
                            press=".onStop" />

                <!-- RETRY 버튼 -->
                    <Button text="RETRY" 
                            icon="sap-icon://refresh"
                            width="11rem"
                            class="peperoGameButton peperoRetry"
                            visible="{= ${game>/challenge/status} === 'RESOLVED' }" 
                            press=".onRetry" />

                <!-- 오른쪽 도트아트 -->
                    <Image src="/image/pepero_individual_pngs/decoration_small_hearts.png"
                           width="100px" height="50px"
                           class="sapUiSmallMarginBegin" />
                </HBox>

            </Panel>
            <VBox width="300px" alignItems="Center">
            <!-- 게임 결과 판넬 -->
                <Panel width="300px" height="500px" class="peperoCard peperoGameFrame sapUiSmallMarginBottom">
                <VBox width="100%" alignItems="Center">

            <!-- 최고 기록 이미지 -->
                <Image src="/image/pepero_individual_pngs/title2.png"
                        width="170px" height="50px"
                        class="sapUiSmallMarginBottom"/>
                <!--Text text="{game>/challenge/bestRecords/0/time}" /-->

            <!-- 최고 기록 TOP 3 -->
                <VBox width="200px" alignItems="Center"
                      items="{game>/challenge/bestRecords}">

                <items>
                <VBox width="100%"
                      alignItems="Center"
                      class="sapUiSmallMarginBottom">

                    <!-- 순위 -->
                    <Title text="{game>rank}"
                           level="H4"
                           class="peperoBrandTitle"/>

                    <!-- 기록 -->
                    <Title text="{game>time}"
                           level="H3"
                           class="peperoBrandTitle peperoTimePlate"/>
                </VBox>
                
            </items>
            
        </VBox>
    </VBox>
</Panel>
                <!-- 시장으로 돌아가기 버튼  -->
                    <Button id="returnButton" 
                            text="시장으로 돌아가기" press=".onMarket" 
                            type="Emphasized" class="peperoGameButton peperoStart sapUiMediumMarginBottom" />
         </VBox>
             </HBox>
               
            </VBox>
        </content>
    </Page>
</mvc:View>
