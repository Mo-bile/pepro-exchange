<mvc:View
    controllerName="pepero.exchange.peperoexchange.controller.Market"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">
    <!-- B / JHJ: 화면 이동만 연결한 기본 화면 -->
    <Page id="marketPage" title="빼빼로 시장" showHeader="false" class="peperoMarketPage">
        <content>
    <VBox
        id="marketContent"
        width="100%"
        class="sapUiResponsiveContentPadding">

        <!-- 픽셀아트 상단 간판 -->
        <VBox
            id="marketHero"
            width="100%"
            class="marketPixelHero">

            <HBox
                width="100%"
                justifyContent="Center"
                alignItems="Center"
                class="marketPixelHeroRow">

                <!-- 왼쪽 데코 -->
                <Image
                    src="/image/market_ui/header_pepero_left.png"
                    width="6rem"
                    densityAware="false"/>

                <!-- 중앙 시장 간판 -->
                <Image
                    src="/image/market_ui/header_market_logo.png"
                    width="20rem"
                    densityAware="false"/>

                <!-- 오른쪽 데코 -->
                <Image
                    src="/image/market_ui/header_pepero_right.png"
                    width="6rem"
                    densityAware="false"/>

            </HBox>

        </VBox>

        <!-- 기존 시장 현황 -->
        <VBox id="MarketCard"
              width="100%"
              class="peperoCard marketMainCard">
                <!-- 시장 현황: PNG 아이콘 + 실시간 데이터 -->
<HBox
    width="100%"
    wrap="Wrap"
    alignItems="Center"
    justifyContent="SpaceBetween"
    class="marketStatusRow sapUiMediumMarginBottom">

    <!-- 시장 현황 제목 -->
    <HBox alignItems="Center" class="marketStatusTitle">
        <Image
            src="/image/market_ui/icon_market_chart.png"
            width="2.5rem"
            densityAware="false"/>

        <Title
            text="시장 현황"
            level="H3"/>
    </HBox>

    <!-- 남은 시간 -->
    <HBox alignItems="Center" class="marketStatusItem">
        <Image
            src="/image/market_ui/icon_clock.png"
            width="2.8rem"
            densityAware="false"/>

        <VBox class="marketStatusText">
            <Label text="남은 시간"/>
            <Text
                text="{path: 'game>/remainingMs',
                       formatter: '.formatRemainingTime'}"
                class="marketStatusValue"/>
        </VBox>
    </HBox>

    <!-- 보유 현금 -->
    <HBox alignItems="Center" class="marketStatusItem">
        <Image
            src="/image/market_ui/icon_coins.png"
            width="2.8rem"
            densityAware="false"/>

        <VBox class="marketStatusText">
            <Label text="보유 현금(PPR)"/>
            <Text
                text="{game>/cash}"
                class="marketStatusValue"/>
        </VBox>
    </HBox>

    <!-- 총자산 -->
    <HBox alignItems="Center" class="marketStatusItem">
        <Image
            src="/image/market_ui/icon_wallet.png"
            width="2.8rem"
            densityAware="false"/>

        <VBox class="marketStatusText">
            <Label text="총자산(PPR)"/>
            <Text
                text="{game>/totalAssets}"
                class="marketStatusValue"/>
        </VBox>
    </HBox>

</HBox>

            <!-- 2. 종목 목록 -->
           
<!-- 차트 + 종목 목록 : 좌우 2열 -->
<l:Grid
    width="100%"
    hSpacing="1"
    vSpacing="1"
    defaultSpan="XL12 L12 M12 S12">

    <!-- 왼쪽 : 선택한 종목의 차트 -->
    <VBox
        width="100%"
        class="peperoCard marketChartPanel">

        <layoutData>
            <l:GridData span="XL7 L7 M12 S12"/>
        </layoutData>

        <Title
            text="{chart>/stockName}"
            level="H3"
            class="marketPanelTitle sapUiSmallMarginBottom"/>

        <ObjectNumber
            number="{chart>/price}"
            unit="PPR"
            class="marketMainPrice sapUiSmallMarginBottom"/>

        <viz:VizFrame
            id="marketPriceChart"
            vizType="line"
            width="100%"
            height="330px"
            vizProperties="{
        title: {visible: false},
        legend: {visible: false},
        plotArea: {
            colorPalette: ['#E879A0'],
            marker: {visible: false}
        }
    }">

            <viz:dataset>
                <viz.data:FlattenedDataset
                    data="{chart>/history}">

                    <viz.data:dimensions>
                        <viz.data:DimensionDefinition
                            name="시간"
                            value="{chart>time}"/>
                    </viz.data:dimensions>

                    <viz.data:measures>
                        <viz.data:MeasureDefinition
                            name="가격"
                            value="{chart>price}"/>
                    </viz.data:measures>

                </viz.data:FlattenedDataset>
            </viz:dataset>

            <viz:feeds>
                <viz.feeds:FeedItem
                    uid="valueAxis"
                    type="Measure"
                    values="가격"/>

                <viz.feeds:FeedItem
                    uid="categoryAxis"
                    type="Dimension"
                    values="시간"/>
            </viz:feeds>

        </viz:VizFrame>

        <Button
            text="매매하기"
            press=".onOpenTrade"
            type="Emphasized"
            width="100%"
            class="marketTradeButton sapUiSmallMarginTop"/>

    </VBox>

    <!-- 오른쪽 : 전체 종목 목록 -->
    <VBox
        width="100%"
        class="peperoCard marketStocksPanel">

        <layoutData>
            <l:GridData span="XL5 L5 M12 S12"/>
        </layoutData>

        <Title
            text="전체 빼빼로"
            level="H3"
            class="marketPanelTitle  sapUiSmallMarginBottom"/>

        <ScrollContainer
            height="430px"
            vertical="true"
            horizontal="false"
            width="100%">

            <Table
                id="marketStocksTable"
                items="{game>/stocks}"
                width="100%"
                mode="SingleSelectMaster"
                selectionChange=".onSelectStock">

                <columns>
                    <Column>
                        <Text text="빼빼로 명"/>
                    </Column>

                    <Column hAlign="End">
                        <Text text="현재가"/>
                    </Column>

                    <Column hAlign="End">
                        <Text text="보유량"/>
                    </Column>
                </columns>

                <items>
                    
<ColumnListItem>
    <cells>

        <!-- 종목 이미지 + 종목명 -->
        <HBox
            alignItems="Center"
            class="marketStockCell">

            <Image
                src="{
                    path: 'game>id',
                    formatter: '.formatStockImage'
                }"
                width="1.6rem"
                height="2.5rem"
                densityAware="false"
                decorative="true"
                class="marketStockImage"/>

            <Text
                text="{game>name}"
                wrapping="false"
                class="marketStockName"/>

        </HBox>

        <!-- 현재가: 기존 바인딩 유지 -->
        <VBox>  
            <Text text="{game>price}"/>
            <Text
                text="{= ${game>changeRate} + '%' }"
                class="sapUiTinyMarginBegin"/>
        </VBox>

        <!-- 보유 수량: 기존 바인딩 유지 -->
        <Text text="{game>quantity}"/>

    </cells>
</ColumnListItem>

                </items>

            </Table>

        </ScrollContainer>

    </VBox>

</l:Grid>

            
            </VBox>
                <VBox id="marketCard" width="100%" class="peperoCard">
                    <!--Text id="marketNotice" text="화면 이동 확인용 기본 화면입니다. 게임 기능은 구현 예정입니다." class="sapUiSmallMarginBottom" -->
                    <HBox justifyContent="Center">
                    <Button id="challengeButton" text="11.11초 챌린지로 이동" press=".onChallenge" type="Emphasized" class=" peperoGameButton peperoStart sapUiMediumMarginBottom" />
                    <Button id="homeButton1" text="시작 화면으로" press=".onHome" type="Transparent" class="peperoGameButton peperoStart sapUiMediumMarginBottom sapUiSmallMarginBegin" />
                    </HBox>
                    <Button id="resultButton" text="결과 화면 확인 (개발용)" press=".onResult" type="Default" class="sapUiSmallMarginBottom" />
                    <!--Button text="매매하기" press=".onOpenTrade" -->
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
