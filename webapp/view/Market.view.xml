<mvc:View
    controllerName="pepero.exchange.peperoexchange.controller.Market"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">
    <!-- B / JHJ: 화면 이동만 연결한 기본 화면 -->
    <Page id="marketPage" title="빼빼로 시장">
        <customHeader>
            <Bar id="marketHeader">
                <contentMiddle>
                    <Title id="marketBrandTitle" text="빼빼로 시장" level="H2" class="peperoBrandTitle" />
                </contentMiddle>
            </Bar>
        </customHeader>
        <content>
            <VBox id="marketContent" class="sapUiResponsiveContentPadding sapUiMediumMarginTop">

            <VBox id="MarketCard" width='100%' class="peperoCard">

                <!-- 시장 정보 -->
                <Title text="시장 현황" level="H3" class="sapUiSmallMarginBottom"/>
                <HBox wrap="Wrap" class="sapUiMediumMarginBottom">
                    <!-- 남은 시간 -->
                    <VBox class="sapUiMediumMarginEnd">
                        <Label text="남은 시간"/>
                        <Text text="{path: 'game>/remainingMs',
                        formatter: '.formatRemainingTime'}"/>
                    </VBox>

                    <!-- 현금 -->
                    <VBox class="sapUiMediumMarginEnd">
                        <Label text="보유 현금(PPR)"></Label>
                        <Text text="{game>/cash}"/>
                    </VBox>

                    <!-- 총자산 -->
                     <VBox>
                    <Label text="총자산 (PPR)" />
                    <Text text="{game>/totalAssets}" />
                </VBox>

            </HBox>

            <!-- 2. 종목 목록 -->
           
<!-- 차트 + 종목 목록 : 좌우 2열 -->
<l:Grid
    width="100%"
    hSpacing="1"
    vSpacing="1"
    defaultSpan="XL12 L12 M12 S12">

    <!-- 왼쪽 : 선택한 종목의 차트 -->
    <VBox
        width="40rem"
        class="peperoCard">

        <layoutData>
            <l:GridData span="XL7 L7 M12 S12"/>
        </layoutData>

        <Title
            text="{chart>/stockName}"
            level="H3"
            class="sapUiSmallMarginBottom"/>

        <ObjectNumber
            number="{chart>/price}"
            unit="PPR"
            class="sapUiSmallMarginBottom"/>

        <viz:VizFrame
            id="marketPriceChart"
            vizType="line"
            width="35rem"
            height="330px">

            <viz:dataset>
                <viz.data:FlattenedDataset
                    data="{chart>/history}">

                    <viz.data:dimensions>
                        <viz.data:DimensionDefinition
                            name="시간"
                            value="{chart>time}"/>
                    </viz.data:dimensions>

                    <viz.data:measures>
                        <viz.data:MeasureDefinition
                            name="가격"
                            value="{chart>price}"/>
                    </viz.data:measures>

                </viz.data:FlattenedDataset>
            </viz:dataset>

            <viz:feeds>
                <viz.feeds:FeedItem
                    uid="valueAxis"
                    type="Measure"
                    values="가격"/>

                <viz.feeds:FeedItem
                    uid="categoryAxis"
                    type="Dimension"
                    values="시간"/>
            </viz:feeds>

        </viz:VizFrame>

        <Button
            text="매매하기"
            press=".onOpenTrade"
            type="Emphasized"
            width="100%"
            class="sapUiSmallMarginTop"/>

    </VBox>

    <!-- 오른쪽 : 전체 종목 목록 -->
    <VBox
        width="30rem"
        class="peperoCard">

        <layoutData>
            <l:GridData span="XL5 L5 M12 S12"/>
        </layoutData>

        <Title
            text="전체 빼빼로"
            level="H3"
            class="sapUiSmallMarginBottom"/>

        <ScrollContainer
            height="430px"
            vertical="true"
            horizontal="false"
            width="100%">

            <Table
                id="marketStocksTable"
                items="{game>/stocks}"
                width="100%"
                mode="SingleSelectMaster"
                selectionChange=".onSelectStock">

                <columns>
                    <Column>
                        <Text text="빼빼로 명"/>
                    </Column>

                    <Column hAlign="End">
                        <Text text="현재가"/>
                    </Column>

                    <Column hAlign="End">
                        <Text text="보유량"/>
                    </Column>
                </columns>

                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{game>name}"/>
                            <Text text="{game>price}"/>
                            <Text text="{game>quantity}"/>
                        </cells>
                    </ColumnListItem>
                </items>

            </Table>

        </ScrollContainer>

    </VBox>

</l:Grid>

            
            
            </VBox>
                <VBox id="marketCard" width="100%" class="peperoCard">
                    <Text id="marketNotice" text="화면 이동 확인용 기본 화면입니다. 게임 기능은 구현 예정입니다." class="sapUiSmallMarginBottom" />
                    <Button id="challengeButton" text="11.11초 챌린지로 이동" press=".onChallenge" type="Emphasized" class="sapUiSmallMarginBottom" />
                    <Button id="resultButton" text="결과 화면 확인 (개발용)" press=".onResult" type="Default" class="sapUiSmallMarginBottom" />
                    <Button id="homeButton1" text="시작 화면으로" press=".onHome" type="Transparent" class="sapUiSmallMarginBottom" />
                    <Button text="매매하기" press=".onOpenTrade" />
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
