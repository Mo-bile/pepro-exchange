{
  "_version": "1.60.0",
  "sap.app": {
    "id": "pepero.exchange.peperoexchange",
    "type": "application",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "빼빼로 증권거래소",
    "description": "빼빼로 주식 거래와 11.11초 챌린지를 즐기는 게임",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.33.0",
      "toolsId": "12624858-58f8-4c33-837a-525446d9753f"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.120.52",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {},
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "pepero.exchange.peperoexchange.view",
        "async": true,
        "viewPath": "pepero.exchange.peperoexchange.view"
      },
      "routes": [
        {
          "name": "RouteHome",
          "pattern": ":?query:",
          "target": [
            "TargetHome"
          ]
        },
        {
          "name": "RouteMarket",
          "pattern": "market:?query:",
          "target": [
            "TargetMarket"
          ]
        },
        {
          "name": "RouteChallenge",
          "pattern": "challenge:?query:",
          "target": [
            "TargetChallenge"
          ]
        },
        {
          "name": "RouteResult",
          "pattern": "result:?query:",
          "target": [
            "TargetResult"
          ]
        }
      ],
      "targets": {
        "TargetHome": {
          "id": "Home",
          "name": "Home"
        },
        "TargetMarket": {
          "id": "Market",
          "name": "Market"
        },
        "TargetChallenge": {
          "id": "Challenge",
          "name": "Challenge"
        },
        "TargetResult": {
          "id": "Result",
          "name": "Result"
        }
      }
    },
    "rootView": {
      "viewName": "pepero.exchange.peperoexchange.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
