    <Dialog
        id="tradeDialog"
        contentWidth="36rem"
        class="peperoTradeDialog">

        <customHeader>
            <Toolbar class="peperoDialogHeader">
                <ToolbarSpacer />
                <Title
                    text="♥ 빼빼로 매매 ♥"
                    class="peperoDialogTitle" />
                <ToolbarSpacer />
            </Toolbar>
        </customHeader>

        <VBox
            class="tradeContent"
            alignItems="Stretch">

            <Title
                text="♥ 주문 ♥"
                level="H3"
                class="tradeHeading" />

            <Text
                text="현금 · {game>/cash} PPR"
                class="tradeCash sapUiSmallMarginBottom" />

            <Label
                text="♥ 종목 ♥"
                class="tradeLabel" />

            <Select
                id="stockSelect"
                width="100%"
                items="{game>/stocks}"
                change=".onStockChange"
                class="tradeSelect">

                <core:Item
                    key="{game>id}"
                    text="{game>name}" />
            </Select>

            <Panel class="tradePriceBox sapUiSmallMarginTop">
                <Text
                    id="currentPriceText"
                    text="현재가: -" />
            </Panel>

            <Label
                text="♥ 수량 ♥"
                class="tradeLabel sapUiSmallMarginTop" />

            <!-- 수량 조절 Input창 -->
            <HBox width="100%" alignItems="Center">
                <StepInput
                id="qtyInput"
                value="1"
                min="1"
                max="100"
                step="1"
                width="12rem"
                change=".onQuantityChange"/>

            </HBox>
            <HBox width="100%" alignItems="Center">
            <Button
                text="최대 구매♥"
                type="Emphasized"
                class="pepBuyButton"
                press=".onMaxBuy"/>

                <Button
                text="전체 매도♥"
                type="Default"
                class="pepSellButton sapUiTinyMarginBegin"
                press=".onMaxSell"/>
            
            </HBox>
            <Text
                id="expectedAmountText"
                text="예상 거래금액: 0 PPR"
                class="sapUiSmallMarginTop" />

            <Text
                id="feeText"
                text="수수료: 0 PPR" />

            <HBox
                class="sapUiSmallMarginTop"
                justifyContent="Center">

                <Button
                    text="매수 ♥"
                    class="pepBuyButton"
                    press=".onBuy" />

                <Button
                    text="매도 ♥"
                    class="pepSellButton sapUiTinyMarginBegin"
                    press=".onSell" />
            </HBox>

            <Panel class="tradeHoldingBox sapUiMediumMarginTop">
                <VBox alignItems="Center">
                    <Title
                        text="♥ 보유 현황 ♥"
                        level="H4" />

                    <Text
                        id="holdingText"
                        text="보유수량: 0주" />
                </VBox>
            </Panel>

        </VBox>

        <endButton>
            <Button
                text="닫기"
                press=".onCloseTrade" />
        </endButton>

    </Dialog>


</core:FragmentDefinition> 
