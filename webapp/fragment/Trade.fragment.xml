<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="tradeDialog"
        title="빼빼로 매매"
        contentWidth="26rem">

        <VBox class="sapUiMediumMargin">

            <!-- 현재 보유 현금 -->
            <Title text="주문" level="H3" />

            <Text
                text="현금: {game>/cash} PPR"
                class="sapUiSmallMarginBottom" />

            <!-- 종목 선택 -->
            <Label text="종목" />

            <Select
                id="stockSelect"
                width="100%"
                items="{game>/stocks}"
                change=".onStockChange">

                <core:Item
                    key="{game>id}"
                    text="{game>name}" />

            </Select>

            <!-- 선택한 종목 현재가 -->
            <Text
                id="currentPriceText"
                text="현재가: -"
                class="sapUiSmallMarginTop" />

            <!-- 수량 입력 -->
            <Label
                text="수량"
                class="sapUiSmallMarginTop" />

            <Input
                id="qtyInput"
                type="Number"
                width="100%"
                placeholder="매매 수량을 입력하세요"
                liveChange=".onQuantityChange" />

            <!-- 주문 예상 정보 -->
            <Text
                id="expectedAmountText"
                text="예상 거래금액: 0 PPR"
                class="sapUiSmallMarginTop" />

            <Text
                id="feeText"
                text="수수료: 0 PPR" />

            <!-- 매수 / 매도 -->
            <HBox class="sapUiSmallMarginTop">

                <Button
                    text="매수"
                    type="Emphasized"
                    press=".onBuy" />

                <Button
                    text="매도"
                    class="sapUiTinyMarginBegin"
                    press=".onSell" />

            </HBox>

            <!-- 보유현황 -->
            <Title
                text="보유 현황"
                level="H4"
                class="sapUiMediumMarginTop" />

            <Text
                id="holdingText"
                text="보유수량: 0주" />

        </VBox>

        <endButton>
            <Button
                text="닫기"
                press=".onCloseTrade" />
        </endButton>

    </Dialog>

</core:FragmentDefinition>

    
