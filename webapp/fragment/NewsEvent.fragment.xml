
<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="newsDialog"
        showHeader="false"
        contentWidth="36rem"
        horizontalScrolling="false"
        verticalScrolling="false"
        afterClose=".onNewsAfterClose"
        class="peperoNewsImageDialog">

        <content>
            <!-- 뉴스 이미지만 표시 -->
            <Image
                src="{news>/imageSrc}"
                width="100%"
                densityAware="false"
                decorative="false"
                alt="{news>/title}"/>
        </content>

        <endButton>
            <Button
                text="확인"
                press=".onNewsConfirm"
                type="Emphasized"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>
